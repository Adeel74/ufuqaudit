// UfuqAudit — Prisma schema (enhanced with RBAC, organizations, sessions)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("user") // super_admin | admin | manager | editor | developer | user
  plan         String   @default("free") // free | starter | pro | agency
  status       String   @default("active") // active | suspended | pending
  avatar       String?
  bio          String?
  timezone     String?
  lastLoginAt  DateTime?
  emailVerified DateTime?
  twoFactorEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects       Project[]
  audits         Audit[]
  sessions       Session[]
  teamMemberships TeamMember[]
  apiKeys        ApiKey[]
  notifications  Notification[]
  auditLogs      AuditLog[]
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  domain       String?
  industry     String?
  country      String?
  timezone     String?
  currency     String   @default("USD")
  defaultLang  String   @default("en")
  branding     String?  // JSON: { primaryColor, logo, etc }
  whiteLabel   Boolean  @default(false)
  status       String   @default("active") // active | suspended | pending
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMembers   TeamMember[]
  projects      Project[]
}

model TeamMember {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            String   @default("member") // owner | admin | manager | editor | viewer
  invitedBy       String?
  status          String   @default("active") // active | pending | revoked
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, organizationId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String   @unique
  keyPrefix    String
  permissions  String?  // JSON array of permission keys
  ipWhitelist  String?  // JSON array of IPs
  lastUsedAt   DateTime?
  lastUsedIp   String?
  expiresAt    DateTime?
  status       String   @default("active") // active | revoked
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Project {
  id           String   @id @default(cuid())
  name         String
  url          String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  audits       Audit[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Audit {
  id            String   @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url           String
  status        String   @default("pending")
  overallScore  Int      @default(0)
  technicalScore Int     @default(0)
  contentScore  Int      @default(0)
  performanceScore Int   @default(0)
  aeoScore      Int      @default(0)
  geoScore      Int      @default(0)
  securityScore Int      @default(0)
  pagesCrawled  Int      @default(0)
  issuesCount   Int      @default(0)
  criticalCount Int      @default(0)
  errorCount    Int      @default(0)
  warningCount  Int      @default(0)
  opportunityCount Int  @default(0)
  summary       String?
  createdAt     DateTime @default(now())

  pages         AuditPage[]
  issues        Issue[]

  @@index([userId])
  @@index([projectId])
}

model AuditPage {
  id           String   @id @default(cuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url          String
  statusCode    Int?
  title         String?
  metaDescription String?
  h1            String?
  wordCount     Int      @default(0)
  loadTimeMs    Int      @default(0)
  pageSizeKb    Int      @default(0)
  indexable     Boolean  @default(true)
  issuesCount   Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([auditId])
}

model Issue {
  id           String   @id @default(cuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  category     String
  severity     String
  issueType    String
  title         String
  description   String
  impact        String   @default("medium")
  recommendation String?
  pageUrl       String?
  status        String   @default("open")
  createdAt     DateTime @default(now())

  @@index([auditId])
  @@index([category])
  @@index([severity])
}

model Recommendation {
  id           String   @id @default(cuid())
  auditId      String
  issueType    String
  pageUrl      String?
  context      String
  suggestion   String
  model        String?
  createdAt    DateTime @default(now())
}

model Plan {
  id           String   @id
  name         String
  priceMonthly Int
  priceYearly  Int
  urlLimit     Int
  projectLimit Int
  features     String
  popular      Boolean  @default(false)
}

model Subscription {
  id           String   @id @default(cuid())
  userId       String
  planId       String
  status        String   @default("active")
  currentPeriodEnd DateTime?
  createdAt     DateTime @default(now())
}

model Integration {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  status        String   @default("disconnected")
  metadata     String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

model Notification {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // audit_complete | critical_issue | weekly_report | score_improved | score_dropped | new_backlink | keyword_lost | info
  title        String
  description  String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId])
}

model SystemSetting {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  updatedAt    DateTime @updatedAt
}
