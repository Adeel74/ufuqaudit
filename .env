# UfuqAudit — Environment Configuration
# Database (SQLite for development; use PostgreSQL for production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Service (z-ai-web-dev-sdk)
ZAI_API_KEY=

# Auth
AUTH_SECRET=ufuqaudit-super-secret-key-change-in-production-2024
AUTH_TRUST_HOST=true

# Google Search Console (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gsc/callback

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payment (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Redis (optional, for production queue)
REDIS_URL=

# Chrome Extension
CHROME_EXTENSION_ID=
