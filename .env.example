# UfuqAudit — Production Environment Configuration
# Copy this file to .env and update values for your deployment

# Database (SQLite for dev; PostgreSQL for production)
# For PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/ufuqaudit
DATABASE_URL=file:/home/z/my-project/db/custom.db

# App URL (update to your domain)
NEXT_PUBLIC_APP_URL=https://ufuqaudit.app

# AI Service
ZAI_API_KEY=

# Auth (generate a secure random string for production)
AUTH_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
AUTH_TRUST_HOST=true

# Google Search Console OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ufuqaudit.app/api/auth/gsc/callback

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payment (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Redis (for production queue)
REDIS_URL=

# Chrome Extension
CHROME_EXTENSION_ID=
